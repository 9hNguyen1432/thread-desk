{
  "name": "thread-desk",
  "version": "0.1.0",
  "description": "A local Kanban board for AI coding agents running in cmux: see, find, resume and clean up your Claude Code threads.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thread-desk": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude-code",
    "cmux",
    "ai-agents",
    "coding-agents",
    "sessions",
    "kanban",
    "terminal",
    "developer-tools"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "check:secrets": "bash scripts/check-secrets.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "hono": "^4.13.13",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@dnd-kit/react": "^0.5.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
